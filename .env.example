# Copy this file to .env and fill in every value. Never commit .env.

# Public host name of the server, without https:// (for example 1-2-3-4.sslip.io).
# Use localhost to try the stack on your own machine.
N8N_HOST=localhost

# Key that encrypts the credentials stored in n8n. Generate it once and keep it:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me

# Postgres database used by n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n
