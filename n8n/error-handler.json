    {
      "parameters": {
        "jsCode": "// L Error Trigger recoit l execution qui a plante et le workflow concerne.\n// On en tire une ligne lisible : ou, quoi, et le lien vers l execution.\nconst e = $input.first().json;\nconst ex = e.execution || {};\nconst err = ex.error || (e.trigger && e.trigger.error) || {};\nconst wf = e.workflow || {};\nreturn [{ json: {\n  date: $now.toISO(),\n  workflowId: String(wf.id || ''),\n  workflow: String(wf.name || ''),\n  noeud: String(ex.lastNodeExecuted || (err.node && err.node.name) || ''),\n  message: String(err.message || 'Unknown error').slice(0, 500),\n  executionId: String(ex.id || ''),\n  lien: String(ex.url || '')\n} }];"
      },
      "id": "fe20bf7c-00c7-400b-ac2e-5a77a160018b",
