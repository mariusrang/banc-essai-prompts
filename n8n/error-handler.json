    {
      "parameters": {
        "jsCode": "// Le moteur a plante : la campagne qu il traitait est restee \"en cours\"\n// et la page web attendrait indefiniment. On retient les campagnes en cours\n// lancees dans les 45 dernieres minutes (le moteur a un timeout de 30 min)\n// et on les passe en \"erreur\" avec la cause.\nconst err = $('Decrire l erreur').first().json;\nconst maintenant = Date.now();\nconst FENETRE_MS = 45 * 60 * 1000;\nreturn $input.all()\n  .filter(i => i.json['Campagne ID'])\n  .filter(i => { const d = Date.parse(i.json['Date']); return isNaN(d) || maintenant - d < FENETRE_MS; })\n  .map(i => ({ json: {\n    campagneId: i.json['Campagne ID'],\n    diagnostic: 'The run stopped on an error' + (err.noeud ? ' in the node \"' + err.noeud + '\"' : '') + ': ' + err.message\n  } }));"
      },
      "id": "f61e2900-73f5-40bf-9425-9eeec4f09bdf",
      "name": "Campagnes interrompues",
      "type": "n8n-nodes-base.code",
