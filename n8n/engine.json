      "id": "63407be2-18a3-4e1e-a7b8-0906028eda46",
      "name": "Requete valide",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        592,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst cas = Array.isArray(body.cas) ? body.cas : [];\nconst repetitions = Math.min(Math.max(parseInt(body.repetitions) || 3, 1), 5);\nconst campagneId = 'camp_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 7);\nconst modesValides = ['exact', 'juge', 'libre'];\nconst mode = modesValides.includes(body.mode) ? body.mode : 'exact';\nconst prompt = String(body.prompt || '');\nconst temperature = typeof body.temperature === 'number' ? body.temperature : 0.7;\n\nconst runs = [];\ncas.forEach((c, i) => {\n  for (let r = 1; r <= repetitions; r++) {\n    runs.push({\n      campagneId,\n      casId: 'cas_' + (i + 1),\n      entree: String(c.entree != null ? c.entree : ''),\n      attendu: mode === 'libre' ? '' : String(c.attendu != null ? c.attendu : ''),\n      repetition: r,\n      mode,\n      prompt,\n      temperature\n    });\n  }\n});\n\nreturn [{ json: {\n  campagneId,\n  nom: String(body.nom || 'Campagne sans nom'),\n  prompt,\n  mode,\n  temperature,\n  repetitions,\n  nbCas: cas.length,\n  nbAppels: runs.length,\n  runs\n} }];"
      },
      "id": "076d7638-581a-47fc-8cce-c09bb29f75fc",
      "name": "Preparer la campagne",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        816,
        176
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ campagneId: $json.campagneId, statut: \"en cours\", nbAppels: $json.nbAppels, nbCas: $json.nbCas }) }}",
